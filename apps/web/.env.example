# Copy to .env.local and fill in. .env.local is gitignored.

# Encrypts store access tokens and LLM API keys at rest in the SQLite DB
# (AES-256-GCM). Without it, secrets are stored in plaintext. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or:  openssl rand -base64 32
# Keep it out of the repo and out of data/. Losing it means re-entering tokens.
APP_ENCRYPTION_KEY=

# Optional: default LLM keys for semantic scoring (can also be set in Settings)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional OpenAI semantic judge throttling. Defaults are conservative for RPM limits.
# OPENAI_JUDGE_CONCURRENCY=1
# OPENAI_JUDGE_MIN_DELAY_MS=500

# Auth.js — required for sign-in. Generate AUTH_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google SSO — leave blank for dev-login only. Fill when the OAuth client exists.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Company domain allowed to sign in via Google (default commerce.com)
# AUTH_ALLOWED_DOMAIN=commerce.com
